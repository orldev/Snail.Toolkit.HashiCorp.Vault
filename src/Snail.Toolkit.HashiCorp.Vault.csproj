<Project Sdk="Snail.Sdk.Library">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <PackageId>Snail.Toolkit.HashiCorp.Vault</PackageId>
        <PackageTags>HashiCorp;Vault;Configuration;Secrets;AppRole</PackageTags>
        <Title>Snail.Toolkit.HashiCorp.Vault</Title>
        <Authors>Toolkit</Authors>
        <Description>HashiCorp Vault KV v2 secrets as a .NET IConfiguration source: AppRole or token authentication, per-secret configuration sections, background reload.</Description>
        <Copyright>Toolkit, 2023</Copyright>
        <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.HashiCorp.Vault</RepositoryUrl>
        <PackageProjectUrl>https://github.com/orldev/Snail.Toolkit.HashiCorp.Vault</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <SnailNotNativeBecause>Snail.Toolkit.HttpBuilder.Extensions 0.3.0 reads every Vault answer through reflection-based JSON: in a native app the first read fails (reflection-based serialization is disabled) and the publish warns (IL2104, IL3053); native once a release of it takes JsonTypeInfo and the reads pass a source-generated context.</SnailNotNativeBecause>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.Toolkit.HashiCorp.Vault.Tests" />
        <InternalsVisibleTo Include="Snail.Toolkit.HashiCorp.Vault.Benchmarks" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
      <PackageReference Include="Snail.Toolkit.HttpBuilder.Extensions" />
    </ItemGroup>

</Project>
